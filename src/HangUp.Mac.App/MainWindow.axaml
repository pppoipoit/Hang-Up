<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HangUp.Mac.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="740"
        Width="440" Height="740"
        CanResize="False"
        x:Class="HangUp.Mac.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/handup.ico"
        Title="Hang Up !!"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="Button.action-btn">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="46"/>
        </Style>
    </Window.Styles>

    <Panel>
        <!-- Background Glassmorphism Acrylic -->
        <ExperimentalAcrylicBorder IsHitTestVisible="False">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial
                    BackgroundSource="Digger"
                    TintColor="#0b0f19"
                    TintOpacity="0.92"
                    MaterialOpacity="0.85" />
            </ExperimentalAcrylicBorder.Material>
        </ExperimentalAcrylicBorder>

        <Grid RowDefinitions="Auto,*">
            <!-- Top Drag Area for Custom Window -->
            <Border Grid.Row="0" Height="36" Background="Transparent" IsHitTestVisible="True" />

            <!-- Main Content ScrollArea -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,10,24,24" Spacing="18">

                    <!-- Header with App Icon -->
                    <StackPanel HorizontalAlignment="Center" Spacing="6">
                        <Image Source="/Assets/handup.png" Width="80" Height="80" HorizontalAlignment="Center" />
                        <TextBlock Text="Hang Up !!" FontSize="22" FontWeight="ExtraBold" Foreground="#f8fafc" HorizontalAlignment="Center" LetterSpacing="0.5"/>
                        <TextBlock Text="Manage your application firewall" FontSize="13" Foreground="#64748b" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Stats Pill Bar -->
                    <Border Background="#141e33" CornerRadius="14" Padding="14,10" BorderBrush="#1e293b" BorderThickness="1">
                        <Grid ColumnDefinitions="*,*,*">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                <Ellipse Width="8" Height="8" Fill="#ef4444"/>
                                <TextBlock Text="Blocked" FontSize="12" Foreground="#94a3b8" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding BlockedCount}" FontSize="13" FontWeight="Bold" Foreground="#f8fafc" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                <Ellipse Width="8" Height="8" Fill="#10b981"/>
                                <TextBlock Text="Allowed" FontSize="12" Foreground="#94a3b8" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding AllowedCount}" FontSize="13" FontWeight="Bold" Foreground="#f8fafc" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                <Ellipse Width="8" Height="8" Fill="#3b82f6"/>
                                <TextBlock Text="Rules" FontSize="12" Foreground="#94a3b8" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalRulesCount}" FontSize="13" FontWeight="Bold" Foreground="#f8fafc" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- App Cards List -->
                    <ItemsControl ItemsSource="{Binding Apps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AppItemViewModel">
                                <Border Background="#111827" CornerRadius="16" Padding="16,14" Margin="0,0,0,12" 
                                        BorderBrush="#1f2937" BorderThickness="1">
                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <!-- App Icon -->
                                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" ClipToBounds="True" Background="#1e293b">
                                            <Image Source="{Binding IconImage}" Width="48" Height="48" Stretch="UniformToFill" />
                                        </Border>

                                        <!-- App Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="4">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="#f8fafc"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding StatusColor}"/>
                                                <TextBlock Text="•" FontSize="10" Foreground="#475569"/>
                                                <TextBlock Text="{Binding RulesText}" FontSize="12" Foreground="#64748b"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Toggle Switch -->
                                        <ToggleSwitch Grid.Column="2" 
                                                      IsChecked="{Binding IsBlocked, Mode=TwoWay}"
                                                      OnContent="" OffContent="" 
                                                      VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Percentage & Rules Bottom Summary -->
                    <Border Background="#0f172a" CornerRadius="14" Padding="16,12" BorderBrush="#1e293b" BorderThickness="1">
                        <Grid ColumnDefinitions="*,*">
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding BlockedPercentage}" FontSize="20" FontWeight="ExtraBold" Foreground="#38bdf8" HorizontalAlignment="Center"/>
                                <TextBlock Text="Blocked Ratio" FontSize="11" Foreground="#64748b" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding TotalRulesCount}" FontSize="20" FontWeight="ExtraBold" Foreground="#f43f5e" HorizontalAlignment="Center"/>
                                <TextBlock Text="Active Domain Blocks" FontSize="11" Foreground="#64748b" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                        <Button Grid.Column="0" Content="Block All" Classes="action-btn"
                                Margin="0,0,8,0"
                                Background="#2563eb" Foreground="White"
                                Command="{Binding BlockAllAsync}"/>

                        <Button Grid.Column="1" Content="Unblock All" Classes="action-btn"
                                Margin="8,0,0,0"
                                Background="#1e1b4b" Foreground="#f43f5e"
                                BorderBrush="#f43f5e" BorderThickness="1"
                                Command="{Binding UnblockAllAsync}"/>
                    </Grid>

                    <!-- Status Message / Loading Indicator -->
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#64748b" HorizontalAlignment="Center" Margin="0,4,0,0"/>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Panel>
</Window>
